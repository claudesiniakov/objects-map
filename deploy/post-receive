#!/bin/bash
# Автодеплой: push в main → код в /var/www/objects-map, зависимости, перезапуск API.
set -e
DEPLOY_DIR="/var/www/objects-map"
BRANCH="main"

while read oldrev newrev refname; do
  branch=$(git rev-parse --symbolic --abbrev-ref "$refname")
  if [ "$branch" = "$BRANCH" ]; then
    echo "==> Deploying branch '$BRANCH' to $DEPLOY_DIR..."
    mkdir -p "$DEPLOY_DIR"
    git --work-tree="$DEPLOY_DIR" --git-dir="$(dirname "$0")/.." checkout -f "$BRANCH"
    cd "$DEPLOY_DIR"
    if [ ! -x .venv/bin/pip ]; then python3 -m venv .venv; fi
    if ! cmp -s requirements.txt .venv/requirements.installed; then
      echo "==> Installing Python dependencies..."
      .venv/bin/pip install -q -r requirements.txt
      cp requirements.txt .venv/requirements.installed
    fi
    install -m 644 deploy/objects-map.service /etc/systemd/system/objects-map.service
    install -m 644 deploy/objects-map-backup.service /etc/systemd/system/objects-map-backup.service
    install -m 644 deploy/objects-map-backup.timer /etc/systemd/system/objects-map-backup.timer
    systemctl daemon-reload
    systemctl restart objects-map
    if ! cmp -s deploy/nginx.conf /etc/nginx/sites-available/objects-map; then
      cp deploy/nginx.conf /etc/nginx/sites-available/objects-map
      nginx -t && systemctl reload nginx
    fi
    echo "==> Deploy complete at $(date)"
  fi
done
